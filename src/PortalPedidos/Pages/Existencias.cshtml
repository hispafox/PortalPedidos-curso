@page
@model ExistenciasModel
@{
    ViewData["Title"] = "Existencias";
}

<h1>Existencias</h1>

<table>
    <thead>
        <tr>
            <th>Producto</th>
            <th>Cajas en el almacén</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var producto in Model.Productos)
        {
            var existencias = Model.Existencias(producto);
            <tr>
                <td>@producto.Nombre</td>
                <td>@(existencias.Agotado ? "Agotado" : existencias.Cajas.ToString())</td>
            </tr>
        }
    </tbody>
</table>
