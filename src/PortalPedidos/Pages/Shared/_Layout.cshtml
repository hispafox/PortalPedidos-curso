<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Portal de pedidos</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <a class="marca" href="/">Portal de pedidos</a>
        <nav>
            @if (User.IsInRole("Tienda"))
            {
                <a asp-page="/Index">Catálogo</a>
                <a asp-page="/Pedido">Tu pedido</a>
                <a asp-page="/Historial">Tus pedidos</a>
                <a asp-page="/Existencias">Existencias</a>
            }
            @if (User.IsInRole("Almacen"))
            {
                <a asp-page="/Almacen/Index">Pedidos nuevos</a>
                <a asp-page="/Almacen/Preparacion">Aplicación del almacén</a>
            }
        </nav>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <span class="tienda">@User.NombreTienda()</span>
            <form method="post" asp-page="/Salir">
                <button type="submit">Salir</button>
            </form>
        }
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>
