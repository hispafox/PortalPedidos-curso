<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Portal de pedidos</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <a class="marca" asp-page="/Index">Portal de pedidos</a>
        <nav>
            <a asp-page="/Index">Catálogo</a>
            <a asp-page="/Pedido">Tu pedido</a>
            <a asp-page="/Existencias">Existencias</a>
        </nav>
        <span class="tienda">Tienda de pruebas</span>
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>
